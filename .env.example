# =====================================================================
# Local environment variables for docker compose.
#
# Copy this file to `.env` (which is git-ignored) and change values if
# you like:   cp .env.example .env
#
# Why a template? Real secrets must never be committed. The template
# documents WHICH variables exist. Each developer keeps their own .env.
# These defaults are fine for local development only.
# =====================================================================

# Postgres superuser (admin tasks, runs the init script)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres

# Password for every per-service user (event_user, booking_user, ...)
SERVICE_DB_PASSWORD=secret

# Keycloak admin console login (http://localhost:8180)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
